# Copy this file to .env and fill in your Gemini key before running docker compose up.
# All other settings are optional — defaults work out of the box.

# Required: Google AI Studio key (embeddings + default Gemini chat model)
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_key_here

# Optional overrides (uncomment to use)
# WHISPER_MODEL=base          # tiny / base / small / medium / large
# LLM_PROVIDER=gemini         # gemini (default) or ollama
