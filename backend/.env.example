# Copy to .env and fill in. Never commit the real .env.

# Provider: "gemini" (default) or "ollama" (local sovereignty mode)
LLM_PROVIDER=gemini

# Gemini (get a free key at https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-key-here
GEMINI_LLM_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

# Ollama (only used when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=llama3.1
OLLAMA_EMBED_MODEL=nomic-embed-text

# Chat (generation) model — selectable, bring-your-own-key, independent of embeddings.
# These can also be set from the in-app Settings UI (stored server-side).
# CHAT_PROVIDER: "gemini" (default) | "openrouter" | "openai_compatible" | "ollama"
CHAT_PROVIDER=gemini
CHAT_MODEL=                      # blank = the provider's default
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENAI_COMPATIBLE_BASE_URL=     # e.g. https://api.openai.com/v1 or your own endpoint
OPENAI_COMPATIBLE_API_KEY=

DATABASE_URL=sqlite:///./deepnotes.db
CHROMA_DIR=./chroma
TABLES_PATH=./tables.duckdb
CORS_ORIGINS=http://localhost:3000
